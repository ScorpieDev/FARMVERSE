# FARMVERSE environment variables
# Copy this file to .env and adjust values. Never commit .env.

# ---- Server ----
NODE_ENV=development
# Address the server listens on (0.0.0.0 so cloud dev environments can forward the port)
HOST=0.0.0.0
PORT=3000
# Local/deployment origin allowed to call the API and open the WebSocket.
# GitHub Codespaces: set CLIENT_ORIGIN=https://localhost:5173. The port
# forwarding rewrites a browser's same-origin Origin
# (https://<codespace-name>-5173.app.github.dev) to https://localhost:5173
# before it reaches Vite and the server. The server also allows this
# workspace's exact forwarded origin, derived from CODESPACE_NAME and
# GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN, in case it arrives unchanged.
# The server logs the rejected origin if neither matches.
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# SQLite database file, relative to the server/ directory (":memory:" = temporary).
# The default data/ folder is git-ignored.
DATABASE_PATH=data/farmverse.db

# ---- Client (Vite only exposes variables prefixed with VITE_) ----
# Origin of the server (no path). Leave empty in development: the client then
# uses its own origin and the Vite dev proxy forwards /api and /ws to the server.
# Set it only when the deployed client and server have different origins
# (use https:// on https pages); ws:// or wss:// is derived from it.
VITE_SERVER_URL=
