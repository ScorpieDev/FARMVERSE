# FARMVERSE environment variables
# Copy this file to .env and adjust values. Never commit .env.

# ---- Server ----
NODE_ENV=development
# Address the server listens on (0.0.0.0 so cloud dev environments can forward the port)
HOST=0.0.0.0
PORT=3000
# Origin allowed to call the API / open the WebSocket (CORS)
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ---- Client (Vite only exposes variables prefixed with VITE_) ----
# Base URL of the server. Use https:// on cloud preview URLs;
# the WebSocket URL (ws:// or wss://) is derived from it.
VITE_SERVER_URL=http://localhost:3000
